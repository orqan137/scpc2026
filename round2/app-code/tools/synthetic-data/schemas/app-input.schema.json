{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scpc.invalid/schemas/safeshare-app-input-v1.json",
  "title": "SafeShare input-only synthetic scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "scenario_id",
    "synthetic",
    "locale",
    "derivation_ref",
    "persona_style",
    "purpose",
    "rooms",
    "episodes"
  ],
  "properties": {
    "schema_version": {
      "const": "safeshare.input.v1"
    },
    "artifact_kind": {
      "const": "safeshare_app_input"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^SS-KO-[0-9]{4}$"
    },
    "synthetic": {
      "const": true
    },
    "locale": {
      "const": "ko-KR"
    },
    "derivation_ref": {
      "type": "string",
      "pattern": "^DRV-[0-9]{4}$"
    },
    "persona_style": {
      "$ref": "#/$defs/personaStyle"
    },
    "purpose": {
      "$ref": "#/$defs/purpose"
    },
    "rooms": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/room"
      }
    },
    "episodes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/episode"
      }
    }
  },
  "$defs": {
    "personaStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persona_key",
        "age_band",
        "region_band",
        "work_context",
        "register",
        "directness",
        "noise_level"
      ],
      "properties": {
        "persona_key": {
          "type": "string",
          "pattern": "^persona-[0-9a-f]{12}$"
        },
        "age_band": {
          "enum": [
            "19_29",
            "30_44",
            "45_59",
            "60_PLUS"
          ]
        },
        "region_band": {
          "enum": [
            "CAPITAL",
            "METRO",
            "NON_METRO"
          ]
        },
        "work_context": {
          "enum": [
            "OFFICE_PROFESSIONAL",
            "PUBLIC_SERVICE",
            "FIELD_PRODUCTION",
            "INDEPENDENT"
          ]
        },
        "register": {
          "enum": [
            "FORMAL_HAPSYO",
            "POLITE_HAEYO",
            "CASUAL_HAE"
          ]
        },
        "directness": {
          "enum": [
            "DIRECT",
            "INDIRECT"
          ]
        },
        "noise_level": {
          "enum": [
            "CLEAN",
            "LIGHT"
          ]
        }
      }
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose_id",
        "display_text"
      ],
      "properties": {
        "purpose_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "display_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "room_id",
        "display_name",
        "members"
      ],
      "properties": {
        "room_id": {
          "type": "string",
          "pattern": "^room-[a-z0-9-]{3,80}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "display_name",
              "member_scope"
            ],
            "properties": {
              "display_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "member_scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          }
        }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "TEXT",
            "LINK",
            "PDF",
            "NONE"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 500
        },
        "asset_ref": {
          "type": "string",
          "pattern": "^synthetic/[a-z0-9._/-]+$",
          "maxLength": 200
        },
        "mime_type": {
          "type": "string",
          "maxLength": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "TEXT"
              }
            }
          },
          "then": {
            "required": [
              "content"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "LINK"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "PDF"
              }
            }
          },
          "then": {
            "required": [
              "asset_ref",
              "mime_type"
            ]
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose_id",
        "target_room_id",
        "target_room_display",
        "current_role",
        "allowed_scope",
        "link_access",
        "share_permission"
      ],
      "properties": {
        "purpose_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "target_room_id": {
          "type": "string",
          "pattern": "^room-[a-z0-9-]{3,80}$"
        },
        "target_room_display": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "current_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "allowed_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "link_access": {
          "enum": [
            "NOT_APPLICABLE",
            "UNKNOWN",
            "PROJECT_ONLY",
            "EXTERNAL_ALLOWED",
            "EXPIRED"
          ]
        },
        "share_permission": {
          "enum": [
            "CAN_SHARE",
            "READ_ONLY"
          ]
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "phase",
        "session",
        "user_utterance",
        "intake",
        "context",
        "candidate_room_ids",
        "actions",
        "read_only_rooms"
      ],
      "properties": {
        "episode_id": {
          "enum": [
            "E1",
            "E2",
            "E3",
            "E4"
          ]
        },
        "phase": {
          "enum": [
            "E1_LEARN",
            "E2_REUSE",
            "E3_EXCEPTION",
            "E4_RECOVER"
          ]
        },
        "session": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "user_utterance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "intake": {
          "$ref": "#/$defs/intake"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "candidate_room_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^room-[a-z0-9-]{3,80}$"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "REVIEW_INTAKE",
              "CONFIRM_CONTEXT",
              "EVALUATE_CANDIDATES",
              "PROPOSE_DRAFT",
              "ADVANCE_SESSION",
              "APPLY_CONTEXT_EVENT",
              "REQUEST_DECISION",
              "CHECKPOINT_IF_HELD",
              "RELAUNCH_IF_CHECKPOINTED",
              "CONFIRM_PENDING_CONTEXT",
              "RESUME_DRAFT"
            ]
          }
        },
        "read_only_rooms": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^room-[a-z0-9-]{3,80}$"
          }
        }
      }
    }
  }
}
